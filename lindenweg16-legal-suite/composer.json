{
  "name": "lindenweg16/legal-suite",
  "description": "Rechtliche Funktionen für lindenweg16.de (Consent, Rechtstexte, Widerruf, Checkout-Compliance).",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": { "php": ">=8.3" },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "brain/monkey": "^2.6",
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": { "psr-4": { "Lindenweg16\\Legal\\": "src/" } },
  "autoload-dev": { "psr-4": { "Lindenweg16\\Legal\\Tests\\": "tests/" } },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "sort-packages": true },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse",
    "lint": "phpcs"
  }
}
